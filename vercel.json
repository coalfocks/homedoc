{
  "buildCommand": "npx tsc --noEmit && npm run lint && npm test -- --runInBand && npm run test:db && npx expo export --platform web",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/privacy", "destination": "/" },
    { "source": "/privacy/", "destination": "/" },
    { "source": "/support", "destination": "/" },
    { "source": "/support/", "destination": "/" },
    { "source": "/auth/callback", "destination": "/" }
  ]
}
